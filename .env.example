# Production Supabase (public browser configuration, also used by API routes).
# Deploy supabase/schema.sql and the submit-score Edge Function first.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Use the public legacy anon JWT for Edge gateway JWT verification.
# Never put the service_role key or any secret key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=your-public-anon-jwt

# Optional alternative backend: Neon Postgres, used only without Supabase above.
# DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
